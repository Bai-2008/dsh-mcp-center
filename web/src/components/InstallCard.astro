---
import { highlightPlaceholders } from "../lib/format";
import type { ServerEntry } from "../lib/types";

interface Props {
  entry: ServerEntry;
}

const { entry } = Astro.props;
const activeInstall = entry.install[0];
const requiredCredentials = entry.credentials.filter(
  (credential) => credential.required,
);
---

<section class="panel install-card" data-install-card aria-labelledby="install-title">
  <div class="panel-heading">
    <div>
      <p class="kicker">INSTALL</p>
      <h2 id="install-title">安装配置</h2>
    </div>
    <p class="panel-note">选择客户端，复制后替换占位符。</p>
  </div>

  <div class="install-tabs" role="tablist" aria-label="选择客户端">
    {
      entry.install.map((item, index) => (
        <button
          type="button"
          class:list={["install-tab", { active: index === 0 }]}
          role="tab"
          data-install-tab={item.id}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
        >
          <span>{item.label}</span>
          <small>{item.subtitle}</small>
        </button>
      ))
    }
  </div>

  {
    entry.install.map((item, index) => (
      <div
        class="install-panel"
        data-install-panel={item.id}
        role="tabpanel"
        hidden={index !== 0}
      >
        <p class="install-hint">
          <code>{item.filename}</code>
          <span>{item.hint}</span>
        </p>
        <div class="code-shell">
          <div class="code-head">
            <span>JSON</span>
            <button type="button" class="copy-button" data-copy>
              <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
                <rect x="5" y="5" width="8" height="8" rx="1.5"></rect>
                <path d="M3 10.5V3.5A1.5 1.5 0 0 1 4.5 2h7"></path>
              </svg>
              <span data-copy-label>复制</span>
            </button>
          </div>
          <pre class="code-block"><code set:html={highlightPlaceholders(item.code)} /></pre>
        </div>
      </div>
    ))
  }

  <aside class="warning-callout" aria-label="必填变量">
    <div class="callout-title">
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16">
        <path d="M10 2 18 16H2L10 2Z"></path>
        <path d="M10 7v4M10 14h.01"></path>
      </svg>
      必填变量
    </div>
    {
      requiredCredentials.length > 0 ? (
        <ul class="required-list">
          {requiredCredentials.map((credential) => (
            <li>
              <div>
                <code>{credential.name}</code>
                <span class="required-desc">{credential.description}</span>
              </div>
              {
                credential.obtain_at ? (
                  <a
                    href={credential.obtain_at}
                    target="_blank"
                    rel="noreferrer"
                  >
                    去申请 ↗
                  </a>
                ) : (
                  <a
                    href={entry.homepage}
                    target="_blank"
                    rel="noreferrer"
                  >
                    查看文档 ↗
                  </a>
                )
              }
            </li>
          ))}
        </ul>
      ) : (
        <p class="required-empty">
          此条目没有必填环境变量或 Header。{entry.auth_note}
        </p>
      )
    }
  </aside>

  <p class="install-footnote">
    {activeInstall?.filename} 中的 <code>&lt;YOUR_...&gt;</code> 都是占位符；真实凭据只保存在本机。
  </p>
</section>
