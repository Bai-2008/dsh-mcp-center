---
import type { SiteInfo } from "../lib/types";

interface Props {
  root: string;
  site: SiteInfo;
}

const { root, site } = Astro.props;
const githubUrl = site.repo_url ?? "https://github.com";
const submitUrl = site.submit_url ?? "https://github.com";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={root} aria-label="MCP 市场首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <path d="M5 7.5 10 12l-5 4.5" />
          <path d="M12 16.5h7" />
        </svg>
      </span>
      <span class="brand-copy">
        <strong>MCP 市场</strong>
        <small>dsh-mcp-center</small>
      </span>
    </a>

    <div class="header-actions">
      <button
        class="search-trigger"
        type="button"
        data-search-open
        aria-label="打开全站搜索"
      >
        <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16">
          <circle cx="8.5" cy="8.5" r="5.5"></circle>
          <path d="m13 13 4 4"></path>
        </svg>
        <span class="search-trigger-label">搜索</span>
        <kbd>⌘K</kbd>
      </button>

      <a
        class="icon-button"
        href={githubUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub 仓库"
        title="GitHub"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path
            d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.7-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.7 3.7 0 0 1 .1-2.7s.8-.3 2.8 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1a3.7 3.7 0 0 1 .1 2.7 3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5a9.5 9.5 0 0 0-3-18.5Z"
          ></path>
        </svg>
      </a>

      <a
        class="submit-link"
        href={submitUrl}
        target="_blank"
        rel="noreferrer"
        title={site.submit_url ? "通过 Issue Forms 投稿" : "部署时配置 SITE_REPO_URL 后可直达投稿表单"}
      >
        投稿
        <span aria-hidden="true">↗</span>
      </a>

      <button
        class="icon-button theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切换深浅色主题"
        title="切换深浅色主题"
      >
        <svg
          class="theme-icon theme-icon-sun"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-moon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
        >
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
