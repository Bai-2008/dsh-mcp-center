---
interface Props {
  root: string;
}

const { root } = Astro.props;
---

<dialog
  class="search-dialog"
  data-search-dialog
  data-root={root}
  data-index-url={`${root}index.json`}
  aria-label="全站搜索"
>
  <div class="search-modal">
    <div class="search-modal-head">
      <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
        <circle cx="8.5" cy="8.5" r="5.5"></circle>
        <path d="m13 13 4 4"></path>
      </svg>
      <input
        type="search"
        class="search-modal-input"
        data-search-input
        placeholder="搜索名称、描述、分类或工具…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索 MCP Server"
        aria-controls="global-search-results"
      />
      <button
        class="search-close"
        type="button"
        data-search-close
        aria-label="关闭搜索"
      >
        Esc
      </button>
    </div>
    <div
      class="search-results"
      id="global-search-results"
      data-search-results
      role="listbox"
      aria-label="搜索结果"
    ></div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</dialog>
